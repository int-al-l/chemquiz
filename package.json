{
  "name": "chemquiz",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:class": "vite --host",
    "build": "vite build",
    "build:demo": "vite build --mode demo --base ./ --outDir dist-demo && node -e \"require('fs').cpSync('backend/static', 'dist-demo/static', {recursive: true})\"",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:pages": "vite build --mode demo --base ./ --outDir docs --emptyOutDir && node -e \"const fs=require('fs');fs.cpSync('backend/static','docs/static',{recursive:true});fs.writeFileSync('docs/.nojekyll','')\""
  },
  "dependencies": {
    "qrcode-generator": "^2.0.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "vite": "^8.2.2",
    "vitest": "^5.0.1"
  }
}
